{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlopSlide",
  "version": "0.1.0",
  "identifier": "dev.slopslide.app",
  "build": {
    "beforeDevCommand": "pnpm speech:build && pnpm video:build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm speech:build && pnpm video:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SlopSlide",
        "width": 1480,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Chat-driven slide editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "speech-runtime/",
      "video-runtime/"
    ]
  }
}
